{
  "name": "eauto",
  "productName": "千川裂变神器",
  "private": true,
  "version": "0.1.0",
  "author": "ECutAuto",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "cross-env ELECTRON_STARTUP_PREVENT=1 vite",
    "dev:app": "vite",
    "restart:dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/restart-dev.ps1",
    "doctor:electron": "node scripts/check-electron.mjs",
    "fix:electron-win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fix-electron-windows.ps1",
    "setup:electron-win": "winget install --id OpenJS.Electron.44 -e --accept-package-agreements --accept-source-agreements",
    "verify:fx": "npx tsx electron/verify/videoEffectsVerify.ts",
    "test:fx-job": "npx tsx electron/verify/jobSmoke.ts",
    "test:quality-p0": "npx tsx electron/verify/qualityP0.ts",
    "test:quality-p1": "npx tsx electron/verify/qualityP1.ts",
    "license:keys": "npx tsx scripts/license/generate-keys.ts",
    "license:issue": "npx tsx scripts/license/issue.ts",
    "license:gui": "start \"\" scripts/license/Issue-ActivationCode.hta",
    "license:prompt": "npx tsx scripts/license/issueGui.ts",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "start": "electron .",
    "postinstall": "node node_modules/electron/install.js",
    "pack:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pack-win.ps1",
    "pack:win:dir": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/ electron-builder --win --dir",
    "pack:mac": "bash scripts/pack-mac.sh"
  },
  "build": {
    "appId": "com.ecutauto.desktop",
    "productName": "千川裂变神器",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.video",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "${productName} ${version}"
    }
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "node-edge-tts": "^1.2.11",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vue-tsc": "^3.3.13",
    "wait-on": "^9.0.3"
  }
}
